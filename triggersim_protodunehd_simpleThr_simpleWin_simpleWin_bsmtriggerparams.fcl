# triggersim_protodunehd_simpleThr_simpleWin_example.fcl

#include "triggersim.fcl"

#include "services_refactored_pdune.fcl"
# this is not a prolog, it has to go just before the actual config
#include "protodune_tools_dune.fcl"

process_name: TriggersimProtoduneHDSimpleThrSimpleWinSimpleWin

services:{
    @table::services_triggersim
    @table::protodunehd_reco_services
}

source:     @local::source_triggersim

outputs:    @local::outputs_triggersim

physics:  @local::physics_triggersim_simpleThr_simpleWin_simpleWin
producers.tamakerTPC.nmodules: @local::nmodules_protodunehd

producers.tamakerTPC.algconfig_plane0.window_length: 20000
producers.tamakerTPC.algconfig_plane0.adc_threshold: 12000000
producers.tamakerTPC.algconfig_plane1.window_length: 20000
producers.tamakerTPC.algconfig_plane1.adc_threshold: 12000000
producers.tamakerTPC.algconfig_plane2.window_length: 20000
producers.tamakerTPC.algconfig_plane2.adc_threshold: 12000000
producers.tamakerTPC.algconfig_plane3.window_length: 20000
producers.tamakerTPC.algconfig_plane3.adc_threshold: 12000000
