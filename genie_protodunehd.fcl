#include "genie_dune.fcl"

BEGIN_PROLOG

protodunehd_genie: @local::dunefd_genie
protodunehd_genie.FluxType: "simple_flux"
#protodunehd_genie.FluxSearchPaths: "/exp/dune/data/users/chasnip/ProtoDUNESimulation/ProtoDUNEGSimpleNuFluxes_v2Apr2025"
protodunehd_genie.FluxSearchPaths: "/pnfs/dune/persistent/users/chasnip/ProtoDUNEBSM/NuFluxWeightedGSimpleFiles_v2"
protodunehd_genie.FluxFiles: ["gsimple_sps_pdhd_allflav_allhad_wnp04_total_*.root"]
protodunehd_genie.FluxCopyMethod: "IFDH"
#protodunehd_genie.FluxCopyMethod: "DIRECT"
protodunehd_genie.TopVolume: "volCryostat"
#protodunehd_genie.TopVolume: "volWorld"
#protodunehd_genie.FiducialCut: "mbox:-360.,0.,0.,360.,607.5,465."
protodunehd_genie.EventsPerSpill: 1
protodunehd_genie.POTPerSpill: 0
protodunehd_genie.GenFlavors: [14, 12, -14, -12] #pdg codes of flux generator neutrino flavors
protodunehd_genie.FluxUpstreamZ: -500  # start neutrinos at z=-1000 independent of flux window positioning

END_PROLOG
